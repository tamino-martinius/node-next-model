{
  "name": "@next-model/core",
  "version": "1.2.2",
  "description": "A typed, promise-based ORM for TypeScript. Declare models with a factory, chain immutable query scopes, manage associations, and plug in any storage via the Connector interface — with validators, callbacks, soft deletes, and a built-in in-memory connector.",
  "keywords": [
    "next-model",
    "orm",
    "typescript",
    "model",
    "database",
    "query-builder",
    "active-record",
    "migrations",
    "validation",
    "esm"
  ],
  "author": "Tamino Martinius <dev@zaku.eu>",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/__benchmark__"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tamino-martinius/node-next-model.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "build": "pnpm clean && tsc",
    "prepack": "pnpm build"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
